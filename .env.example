# Autional 公开配置（可提交；NEXT_PUBLIC_* 会打包进前端，勿放密钥）
# 必填：issuer 为共享域名，必须显式给租户 ID
NEXT_PUBLIC_AUTIONAL_TENANT_ID=
NEXT_PUBLIC_AUTIONAL_ISSUER=https://api.autional.cn
# 同源 BFF 代理路径
NEXT_PUBLIC_AUTIONAL_API_URL=/bff
# 当前应用客户端；留空则只显示邮箱密码登录
NEXT_PUBLIC_AUTIONAL_APP_ID=client-Ost6T4zMRKoh
NEXT_PUBLIC_AUTIONAL_AUTHORIZE_URL=https://auth.autional.cn/oauth/api/v1/oauth/authorize

# 服务端专用：Neon Postgres 连接串（pooled）。仅服务端读取，勿加 NEXT_PUBLIC_ 前缀。
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# 服务端专用：文档字段加密密钥（32 字节 base64）。生成：openssl rand -base64 32
# 丢失该密钥将无法解密已有文档，请另行备份。
# CONTENT_ENCRYPTION_KEY=
# CONTENT_ENCRYPTION_KEY_KID=k1
